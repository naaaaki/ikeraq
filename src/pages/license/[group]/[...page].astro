---
/**
 * ライセンス区分ごとの一覧
 *
 * ★ 断定しない。「使える／使えない」ではなく「確認が要る／障害になりにくい」まで。
 * ★ カテゴリとの掛け合わせページへの入口をここに置く。
 *   399件を1画面に並べても選べないので、絞り込む先を示す。
 * ★ 1ページ50件でページ分けする（paginate.ts）。1ページ目の URL は今までと同じ。
 *   「分野で絞る」は全件から数えるので、どのページでも同じものを出す。
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Sidebar from '../../../components/Sidebar.astro';
import RepoListSection from '../../../components/RepoListSection.astro';
import {
  getSiteData,
  licenseCrossCategories,
  licenseGroupItems,
  LICENSE_GROUPS,
  type LicenseGroup,
  type RepoView,
} from '../../../lib/content.js';
import { categoryLabel, num } from '../../../lib/format.js';
import { paginate, type PagerInfo } from '../../../lib/paginate.js';

export const getStaticPaths = (async () => {
  const site = await getSiteData();
  return LICENSE_GROUPS.flatMap((group) => {
    const all = licenseGroupItems(site, group);
    const crosses = licenseCrossCategories(all);
    const noteTotal = all.filter((v) => v.note !== null).length;
    return paginate(all, `/license/${group.key}/`).map((slice) => ({
      params: { group: group.key, page: slice.param },
      props: { group, items: slice.items, pager: slice.pager, crosses, noteTotal },
    }));
  });
}) satisfies GetStaticPaths;

interface Props {
  group: LicenseGroup;
  items: RepoView[];
  pager: PagerInfo;
  crosses: { key: string; count: number }[];
  noteTotal: number;
}
const { group, items, pager, crosses, noteTotal } = Astro.props;

const total = pager.allCount;
const order = noteTotal > 0 ? `紹介文のあるものが先 · 増加の多い順 · ${num(total)}件` : `増加の多い順 · ${num(total)}件`;
const pageSuffix = pager.current > 1 ? `（${pager.current}ページ目）` : '';
---

<Base title={`${group.heading}${pageSuffix}`} description={`${group.description}${pageSuffix}`}>
  <main id="main" style="flex: 1; min-width: 0;">
    <nav class="meta" aria-label="パンくず" style="padding-top: 18px;">
      <a href="/" style="color: var(--ink3);">ホーム</a>
      <span style="padding: 0 7px; color: var(--rule2);">/</span>
      <a href="/license/" style="color: var(--ink3);">ライセンス</a>
      <span style="padding: 0 7px; color: var(--rule2);">/</span>
      <span>{group.short}</span>
    </nav>

    <div style="padding: 26px 0 28px;">
      <h1 class="display" style="margin: 0; font-size: 34px; line-height: 1.2;">{group.heading}{pageSuffix && <span class="meta" style="font-size: 15px; margin-left: 10px;">{pageSuffix}</span>}</h1>
      <p class="meta" style="margin: 12px 0 0; font-size: 13px; line-height: 1.9; max-width: 620px;">{group.lede}</p>
    </div>

    {
      crosses.length > 0 && (
        <div style="padding-bottom: 34px;">
          <div class="label" style="margin-bottom: 10px;">分野で絞る</div>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            {crosses.map((c) => (
              <a href={`/license/${group.key}/${c.key}/`} class="chip">
                {categoryLabel(c.key)}
                <span class="num" style="margin-left: 6px; color: var(--ink3);">{c.count}</span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <RepoListSection
      items={items}
      label={group.heading}
      note={order}
      empty="該当するリポジトリはまだありません。"
      pager={pager}
      noteTotal={noteTotal}
    />
  </main>

  <Sidebar />
</Base>
