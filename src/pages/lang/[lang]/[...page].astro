---
/**
 * 言語別
 *
 * URL は小文字にする。GitHub の言語名は表記が揺れる（C# / F# など記号も入る）ので、
 * URL 用の鍵と表示名を分けて持つ。
 *
 * ★ 1ページ50件でページ分けする（paginate.ts）。1ページ目の URL は今までと同じ。
 */
import type { GetStaticPaths } from 'astro';
import ListPage from '../../../layouts/ListPage.astro';
import { byNoteFirst, getSiteData, type RepoView } from '../../../lib/content.js';
import { languageSlug, num } from '../../../lib/format.js';
import { paginate, type PagerInfo } from '../../../lib/paginate.js';

export const getStaticPaths = (async () => {
  const site = await getSiteData();
  // ★ URL は languageSlug で作る。小文字化だけだと C# が /lang/c%23/、
  //   Jupyter Notebook が空白入りの URL になり、リンク先として成立しない
  const groups = new Map<string, { name: string; items: RepoView[] }>();
  for (const item of site.repos) {
    const name = item.repo.language;
    if (!name) continue;
    const key = languageSlug(name);
    const group = groups.get(key);
    if (group) {
      // 別の言語名が同じ URL になった場合。表示名は先に来たほうを残す
      group.items.push(item);
    } else {
      groups.set(key, { name, items: [item] });
    }
  }
  return [...groups.entries()].flatMap(([key, group]) => {
    const sorted = group.items.sort(byNoteFirst);
    const noteTotal = sorted.filter((v) => v.note !== null).length;
    return paginate(sorted, `/lang/${key}/`).map((slice) => ({
      params: { lang: key, page: slice.param },
      props: { name: group.name, items: slice.items, pager: slice.pager, noteTotal },
    }));
  });
}) satisfies GetStaticPaths;

interface Props {
  name: string;
  items: RepoView[];
  pager: PagerInfo;
  noteTotal: number;
}
const { name, items, pager, noteTotal } = Astro.props;
const total = pager.allCount;
const order = noteTotal > 0 ? `紹介文のあるものが先 · 増加の多い順 · ${num(total)}件` : `増加の多い順 · ${num(total)}件`;
---

<ListPage
  title={`${name} のリポジトリ`}
  heading={`${name} のリポジトリ`}
  description={`${name} で書かれた、GitHub で注目されているリポジトリ${num(total)}件。`}
  items={items}
  label={`${name} のリポジトリ`}
  note={order}
  empty={`${name} のリポジトリはまだありません。`}
  pager={pager}
  noteTotal={noteTotal}
/>
