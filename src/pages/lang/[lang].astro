---
/**
 * 言語別
 *
 * URL は小文字にする。GitHub の言語名は表記が揺れる（C# / F# など記号も入る）ので、
 * URL 用の鍵と表示名を分けて持つ。
 */
import type { GetStaticPaths } from 'astro';
import ListPage from '../../layouts/ListPage.astro';
import { byMomentum, getSiteData, type RepoView } from '../../lib/content.js';
import { languageSlug, num } from '../../lib/format.js';

export const getStaticPaths = (async () => {
  const site = await getSiteData();
  // ★ URL は languageSlug で作る。小文字化だけだと C# が /lang/c%23/、
  //   Jupyter Notebook が空白入りの URL になり、リンク先として成立しない
  const groups = new Map<string, { name: string; items: RepoView[] }>();
  for (const item of site.repos) {
    const name = item.repo.language;
    if (!name) continue;
    const key = languageSlug(name);
    const group = groups.get(key);
    if (group) {
      // 別の言語名が同じ URL になった場合。表示名は先に来たほうを残す
      group.items.push(item);
    } else {
      groups.set(key, { name, items: [item] });
    }
  }
  return [...groups.entries()].map(([key, group]) => ({
    params: { lang: key },
    props: { name: group.name, items: group.items.sort(byMomentum) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  name: string;
  items: RepoView[];
}
const { name, items } = Astro.props;
---

<ListPage
  title={`${name} のリポジトリ`}
  heading={`${name} のリポジトリ`}
  description={`${name} で書かれた、GitHub で注目されているリポジトリ${num(items.length)}件。`}
  items={items}
  label={`${name} のリポジトリ`}
  note={`増加の多い順 · ${num(items.length)}件`}
  empty={`${name} のリポジトリはまだありません。`}
/>
