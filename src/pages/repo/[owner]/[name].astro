---
/**
 * 個別ページ（design/Repo.dc.html / docs/structure-proposal.html）
 *
 * 2種類ある。
 *   A. 紹介文を書いたページ  … 人が書いた文章が主役
 *   B. 書いていないページ    … 記録したデータが主役。Aの短縮版にしない
 *
 * ★ 紹介文も無く、記録も足りないページは noindex にする（SPEC §2.5）。
 *   中身の薄いページを検索エンジンに出すと、サイト全体の評価が下がる。
 * ★ 断定しない。警告は「疑い」までしか言わない（SPEC §8）
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import RepoLink from '../../../components/RepoLink.astro';
import GithubLink from '../../../components/GithubLink.astro';
import ShareX from '../../../components/ShareX.astro';
import StarChart from '../../../components/StarChart.astro';
import Mascot from '../../../components/Mascot.astro';
import { getSiteData, type RepoView } from '../../../lib/content.js';
import { SITE_OPERATOR } from '../../../lib/site.js';
import {
  categoryLabel,
  languageColor,
  languageSlug,
  licenseLabel,
  num,
  repoUrl,
  toJstDate,
  updatedAgo,
} from '../../../lib/format.js';
import { plainText, renderFigure, renderInline, renderMarkdown, splitFigure, splitSections } from '../../../lib/note.js';
import { daysSince } from '../../../../scripts/lib/date.js';

export const getStaticPaths = (async () => {
  const site = await getSiteData();
  return site.repos.map((item) => ({
    params: { owner: item.repo.owner, name: item.repo.name },
    props: { item },
  }));
}) satisfies GetStaticPaths;

interface Props {
  item: RepoView;
}
const { item } = Astro.props;
const { repo, note, delta, history } = item;

const lic = licenseLabel(repo);
const ago = updatedAgo(repo.pushed_at);
const ageDays = daysSince(repo.created_at);

// --- 紹介文をほどく（節ごとに置き場所が違う） ---
const parsed = note ? splitSections(note.body) : null;
const lead = parsed?.sections.get('見出しの一文');
const leadText = lead ? plainText(lead) : null;

const figureSection = parsed?.sections.get('図');
const figure = figureSection ? splitFigure(figureSection) : null;
const figureHtml = figure?.figure ? await renderFigure(figure.figure) : null;
const captionHtml = figure?.caption ? await renderInline(figure.caption) : null;

const BODY_ORDER = ['どういうものか', 'どんなときに使うか', '使い方', '注意点'] as const;
const bodyBlocks = await Promise.all(
  BODY_ORDER.filter((h) => parsed?.sections.has(h)).map(async (h) => ({
    heading: h as string,
    html: await renderMarkdown(parsed!.sections.get(h)!),
  }))
);
const extraBlocks = await Promise.all(
  (parsed?.extra ?? []).map(async (e) => ({ heading: e.heading, html: await renderMarkdown(e.body) }))
);
const blocks = [...bodyBlocks, ...extraBlocks];
// ★「使い方」が無い記事では節ごと出さない（D-006）。空の節を置くと /about/ の説明と食い違う

const slug = (heading: string) => encodeURIComponent(heading);

// --- 関連（同じカテゴリから。回遊の導線） ---
/**
 * ★紹介文があるものを先に出す。
 *   スター数だけで選ぶと、最後まで読んだ人に見せる3件が英語の説明だけになる
 *   （実際にそうなっていた）。日本語で読める先を優先する。
 *   同じ条件どうしはスター数で並べる。
 * ★カテゴリが同じだけでは足りない。トピックが重なるものに限る。
 *   カテゴリは広く、yt-dlp（開発ツール）に alacritty・vscode が並んでいた。
 *   「そのほか」は何も共通しない寄せ集めなので、全体から2つ以上重なるものだけにする。
 *   重なるものが無ければ出さない（無関係なものを並べるより良い）。
 */
const site = await getSiteData();
const hasCategory = !!repo.category && repo.category !== 'other';
const minShared = hasCategory ? 1 : 2;
// 言語名や「cli」のような広すぎる語は、重なっても中身が似ている根拠にならない
const GENERIC_TOPICS = new Set([
  'python', 'python3', 'javascript', 'typescript', 'go', 'golang', 'rust', 'java', 'kotlin', 'swift',
  'c', 'cpp', 'csharp', 'php', 'ruby', 'nodejs', 'node', 'react', 'cli', 'terminal', 'linux', 'macos',
  'windows', 'open-source', 'opensource', 'hacktoberfest', 'awesome', 'awesome-list', 'self-hosted',
]);
const myTopics = new Set((repo.topics ?? []).filter((t) => !GENERIC_TOPICS.has(t)));
const related = site.repos
  .filter((v) => v.repo.id !== repo.id && (!hasCategory || v.repo.category === repo.category))
  .map((v) => ({ v, shared: (v.repo.topics ?? []).filter((t) => myTopics.has(t)).length }))
  .filter((x) => x.shared >= minShared)
  .sort((a, b) => {
    const an = a.v.note ? 0 : 1;
    const bn = b.v.note ? 0 : 1;
    if (an !== bn) return an - bn;
    if (a.shared !== b.shared) return b.shared - a.shared;
    return b.v.repo.stars - a.v.repo.stars;
  })
  .slice(0, 3)
  .map((x) => x.v);

// --- 開発の様子。数字はすべて取得したもの。無いものは出さない ---
type Fact = { v: string; u: string; k: string };
const facts: Fact[] = [
  ageDays >= 365
    ? { v: (ageDays / 365).toFixed(1), u: '年', k: `公開してからの期間。${toJstDate(repo.created_at)} が最初のコミットです` }
    : {
        v: String(Math.max(1, Math.round(ageDays / 30))),
        u: 'か月',
        k: `公開してからの期間。${toJstDate(repo.created_at)} が最初のコミットです`,
      },
  repo.releases_count !== null ? { v: num(repo.releases_count), u: '回', k: 'リリースの回数です' } : null,
  repo.contributors_count !== null ? { v: num(repo.contributors_count), u: '人', k: '開発に参加した人数です' } : null,
  { v: String(ago.days), u: '日前', k: '最後のコミットです' },
  { v: num(repo.open_issues), u: '件', k: '未解決の Issue とプルリクエストの合計です（GitHub はこの2つを同じ数に含めます）' },
  // ★記録日数はここに出さない。同じことをサイドバーのスター推移が示していて、二重になる
].filter((f): f is Fact => f !== null);

/**
 * パンくずの中間に何を置くか。
 *
 * ★「そのほか」を置かない。読む人に何も伝えず、検索エンジンにとっても
 *   意味のない語で1階層を埋めることになる。
 *   分類できたときはカテゴリ、できなければ言語を使う。どちらも無ければ階層を作らない。
 */
const crumb =
  repo.category && repo.category !== 'other'
    ? { name: categoryLabel(repo.category), href: `/category/${repo.category}/` }
    : repo.language
      ? { name: repo.language, href: `/lang/${languageSlug(repo.language)}/` }
      : null;

// --- メタ情報 ---
/**
 * ★ 検索結果に出る文字列に、英語や中国語の原文を使わない。
 *   description_en は GitHub の原文なので、日本語話者向けの検索結果としては読めない
 *   （絵文字だけの説明文もある）。日本語のサイトを名乗る以上、ここは必ず日本語にする。
 *   紹介文が無いページは、取得した数値から日本語の一文を組み立てる。
 *   数値はすべて取得したものなので、これで嘘にはならない。
 */
const factsLine = [
  repo.language ? `${repo.language} のリポジトリ` : null,
  `スター ${num(repo.stars)}`,
  lic.text,
  ago.text,
].filter((v): v is string => v !== null);
// ★区切りは「／」。ライセンスの表記自体が「MIT · 商用可」のように中黒を含むので、
//   同じ記号で項目を区切ると、どこまでが1項目か読めなくなる
/**
 * ★ 紹介文があるページは「どういうものか」の冒頭から作る。
 *   見出しの一文をそのまま使うと、検索結果でタイトルと同じ文が2回並ぶ。
 * ★ 紹介文が無いページで「日本語でまとめています」と書かない。
 *   本文には「まだ紹介文がありません」と出るので、検索結果と中身が食い違う。
 */
const DESCRIPTION_MAX = 120;
const toSnippet = (md: string) => {
  // 図（SVG）の中の文字が説明文に混ざらないよう、先に丸ごと外す
  const text = plainText(md.replace(/<svg[\s\S]*?<\/svg>/g, ''))
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return text.length > DESCRIPTION_MAX ? `${text.slice(0, DESCRIPTION_MAX - 1)}…` : text;
};
const whatSection = parsed?.sections.get('どういうものか');
const description = note
  ? (whatSection ? toSnippet(whatSection) : null) || leadText || repo.id
  : `${repo.id} のスター推移と開発状況の記録です。${factsLine.join('／')}。`;

/**
 * ★ タイトルにはリポジトリ名を必ず入れる。「yt-dlp とは」のように名前で探す人がいちばん多い。
 *   見出しの一文だけだと、名前で検索されても一致する語が無い。
 *   owner は入れない（長くなるうえ、名前で探す人はまず owner を打たない）。
 *   紹介文が無いページは、名前と日本語の語を並べる。
 */
const repoName = repo.id.split('/')[1] ?? repo.id;
const pageTitle = leadText ? `${repoName}：${leadText}` : `${repo.id} のスター数とライセンス`;
const canonical = new URL(repoUrl(repo.id), Astro.site).href;

// ★見えているパンくずと構造化データを一致させる。ずれると検索エンジンに無視される
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
    ...(crumb
      ? [{ '@type': 'ListItem', position: 2, name: crumb.name, item: new URL(crumb.href, Astro.site).href }]
      : []),
    { '@type': 'ListItem', position: crumb ? 3 : 2, name: repo.id, item: canonical },
  ],
};

// 紹介文があるページだけ Article を出す。データだけのページを記事と名乗らせない
const article = note
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: leadText ?? repo.id,
      description,
      inLanguage: 'ja',
      url: canonical,
      datePublished: note.updated ?? undefined,
      dateModified: note.updated ?? undefined,
      author: { '@type': 'Person', name: SITE_OPERATOR },
      publisher: { '@type': 'Organization', name: 'Ikeraq' },
    }
  : null;

/** JSON-LD に閉じタグが混ざるとページが壊れる。文字参照にしてから埋める */
const jsonld = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');

const noteCredit = note
  ? note.updated
    ? `この記事の更新日は ${note.updated} です。`
    : ''
  : 'このページにはまだ紹介文がありません。以下は取得した数値の記録です。';
---

<Base
  title={pageTitle}
  description={description}
  noindex={!repo.is_indexable}
  canonical={canonical}
  ogType={note ? 'article' : 'website'}
  wide
  compact
>
  <script type="application/ld+json" slot="head" is:inline set:html={jsonld(breadcrumb)} />
  {article && <script type="application/ld+json" slot="head" is:inline set:html={jsonld(article)} />}

  <nav class="meta" aria-label="パンくず" style="padding-top: 18px;">
    <a href="/" style="color: var(--ink3);">ホーム</a>
    <span style="padding: 0 7px; color: var(--rule2);">/</span>
    {
      crumb && (
        <>
          <a href={crumb.href} style="color: var(--ink3);">{crumb.name}</a>
          <span style="padding: 0 7px; color: var(--rule2);">/</span>
        </>
      )
    }
    <span>{repo.id}</span>
  </nav>

  <div style="display: flex; gap: 56px; align-items: flex-start; flex-wrap: wrap; padding-top: 26px;">
    <main id="main" class="article">
      <h1 style="margin: 0 0 12px;">
        <RepoLink id={repo.id} size={27} />
      </h1>

      {
        leadText && (
          <p class="display" style="margin: 0 0 22px; font-size: 25px; line-height: 1.5;">
            {leadText}
          </p>
        )
      }

      <div
        style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding-bottom: 30px; border-bottom: 1px solid var(--rule2);"
      >
        <span class={`lic ${lic.tone === 'ok' ? '' : lic.tone}`}>{lic.text}</span>
        {/* ★言語が判定できないものは、丸とダッシュだけが残って意味を持たない。出さない */}
        {repo.language && (
          <span class="meta">
            <span class="lang">
              <span class="dot" style={`background: ${languageColor(repo.language)};`} />
              {repo.language}
            </span>
          </span>
        )}
        <span class="meta">
          ★ <b class="num">{num(repo.stars)}</b>
          {delta !== null && (
            <>
              （今日 <b class="num" style="color: var(--accent);">+{num(delta)}</b>）
            </>
          )}
        </span>
        <span class="meta" style={ago.days >= 180 ? 'color: var(--warn);' : ''}>{ago.text}</span>
        {repo.has_japanese_readme && <span class="meta">日本語 README あり</span>}
      </div>

      {/* ★原典への出口。紹介サイトなので、ここが見つからないと読み手の行き場がなくなる */}
      <div style="padding-top: 22px;">
        <GithubLink id={repo.id} variant="button" />
      </div>

      {/*
        ★ 原文は見出しの直下に置かない。
          日本語で読める場所を探しに来た人が、最初に目にする行が英語や中国語だと、
          その下に何が書いてあっても離脱する。原典の記載として残す価値はあるので、
          GitHub への出口とひとまとめにして、ここに置く。
      */}
      {repo.description_en && (
        <div style="padding-top: 18px;">
          <div class="meta" style="margin-bottom: 5px;">GitHub の説明（原文）</div>
          <div class="en">{repo.description_en}</div>
        </div>
      )}

      {
        repo.flags.length > 0 && (
          <div class="callout" style="margin-top: 30px;">
            <b>気をつける点</b>
            <ul style="margin: 8px 0 0; padding-left: 1.3em;">
              {repo.flags.map((f) => (
                <li>
                  {f.label} — {f.reason}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div style="padding-top: 44px;">
        {
          blocks.map((b) => (
            <section class="block" id={slug(b.heading)}>
              <h2 class="sec">{b.heading}</h2>
              <div class="prose" set:html={b.html} />
              {b.heading === 'どういうものか' && figureHtml && (
                <figure class="fig" style="margin-top: 30px;">
                  <div class="frame" set:html={figureHtml} />
                  {captionHtml && <figcaption set:html={captionHtml} />}
                </figure>
              )}
            </section>
          ))
        }

        {
          !note && (
            <section class="block">
              {/* B型。Aの短縮版にしない。記録したデータを主役にする */}
              <h2 class="sec">記録している数値</h2>
              <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 20px;">
                <Mascot pose="point" size={76} />
                <p class="meta" style="margin: 0; line-height: 1.9;">
                  このリポジトリには、まだ日本語の紹介文がありません。以下は GitHub から取得した数値と、Ikeraq
                  が記録しているスター数の推移です。
                </p>
              </div>
              <StarChart history={history} width={640} height={120} />
            </section>
          )
        }

        <section class="block" id="health">
          <h2 class="sec">開発の様子</h2>
          <div class="facts">
            {
              facts.map((f) => (
                <div class="fact">
                  <div class="v">
                    {f.v}
                    <span class="u">{f.u}</span>
                  </div>
                  <div class="k">{f.k}</div>
                </div>
              ))
            }
          </div>
        </section>

        {
          related.length > 0 && (
            <section class="block" id="similar">
              <h2 class="sec">ほかの候補</h2>
              {related.map((r) => (
                <a
                  href={repoUrl(r.repo.id)}
                  style="display: block; padding: 14px 0; border-bottom: 1px solid var(--rule); color: var(--ink);"
                >
                  <RepoLink id={r.repo.id} size={14.5} />
                  {r.lead ? (
                    <div style="margin-top: 5px; font-size: 13.5px; line-height: 1.7; color: var(--ink2);">{r.lead}</div>
                  ) : (
                    r.repo.description_en && <div class="en" style="margin-top: 5px;">{r.repo.description_en}</div>
                  )}
                </a>
              ))}
            </section>
          )
        }

        {/*
          ★ 共有ボタンは記事を読み終えた位置に置く。冒頭に置くと、読む前に押すことになる。
            紹介文が無いページには出さない。数値の記録だけのページを勧める理由がない。
        */}
        {note && leadText && (
          <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding-top: 8px;">
            <ShareX text={leadText} url={canonical} id={repo.id} />
            <span class="meta">この記事がよかったら</span>
          </div>
        )}

        {/* ★出典と免責。削らないこと（SPEC §8） */}
        <p class="meta" style="line-height: 1.95; border-top: 1px solid var(--rule); padding-top: 22px;">
          {noteCredit}
          内容は公開されている README と GitHub のデータに基づいています。
          数値は GitHub から取得したもの、警告は<a href="/about/criteria/">判定の基準</a
          >にある条件での自動判定です。事実誤認を見つけた場合はお知らせください。
        </p>
      </div>
    </main>

    <aside class="article-aside">
      {
        blocks.length > 0 && (
          <nav class="toc" aria-label="目次">
            <div class="label" style="margin-bottom: 12px;">
              目次
            </div>
            {blocks.map((b) => (
              <a href={`#${slug(b.heading)}`}>{b.heading}</a>
            ))}
            <a href="#health">開発の様子</a>
            {related.length > 0 && <a href="#similar">ほかの候補</a>}
          </nav>
        )
      }

      <section>
        <div class="label" style="padding-bottom: 12px; border-bottom: 1px solid var(--rule2);">スター数</div>
        <div style="padding-top: 14px;">
          <div class="num" style="font-size: 26px; font-weight: 500; line-height: 1;">{num(repo.stars)}</div>
          {
            delta !== null && (
              <div class="meta" style="padding-top: 6px;">
                今日 <b class="num" style="color: var(--accent);">+{num(delta)}</b>
              </div>
            )
          }
          <div style="padding-top: 14px;">
            <StarChart history={history} />
          </div>
        </div>
      </section>

      <section>
        <div class="label" style="padding-bottom: 12px; border-bottom: 1px solid var(--rule2);">そのほかの指標</div>
        <div style="padding-top: 4px;">
          <div class="kv"><span>Fork</span><b>{num(repo.forks)}</b></div>
          {repo.watchers !== null && <div class="kv"><span>Watch</span><b>{num(repo.watchers)}</b></div>}
          <div class="kv"><span>未解決の Issue / PR</span><b>{num(repo.open_issues)}</b></div>
          {repo.contributors_count !== null && <div class="kv"><span>コントリビュータ</span><b>{num(repo.contributors_count)}</b></div>}
          {repo.releases_count !== null && <div class="kv"><span>リリース</span><b>{num(repo.releases_count)}</b></div>}
        </div>
      </section>

      <section>
        <div class="label" style="padding-bottom: 12px; border-bottom: 1px solid var(--rule2);">基本情報</div>
        <div style="padding-top: 4px;">
          <div class="kv"><span>作成</span><b>{toJstDate(repo.created_at)}</b></div>
          <div class="kv"><span>最終コミット</span><b>{toJstDate(repo.pushed_at)}</b></div>
          <div class="kv"><span>日本語 README</span><b>{repo.has_japanese_readme ? 'あり' : 'なし'}</b></div>
          <div class="kv"><span>カテゴリ</span><b>{categoryLabel(repo.category)}</b></div>
        </div>
      </section>
    </aside>
  </div>
</Base>
