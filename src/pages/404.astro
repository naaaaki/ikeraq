---
/**
 * 404
 *
 * 個別ページは「紹介文も無く、記録も足りない」ものが noindex になるだけで、
 * URL 自体は残る。ここに来るのは、消えたリポジトリか打ち間違いのどちらか。
 * 行き先を1つ示して、戻れるようにしておく。
 */
import Base from '../layouts/Base.astro';
---

<Base title="ページが見つかりません" description="お探しのページは見つかりませんでした。" noindex wide compact>
  <main id="main" style="max-width: 620px; padding: 72px 0 96px;">
    <p class="label" style="margin-bottom: 14px;">404</p>
    <h1 class="display" style="margin: 0 0 18px; font-size: 32px; line-height: 1.25;">ページが見つかりませんでした</h1>
    <p class="meta" style="margin: 0 0 28px; line-height: 1.95;">
      URL が変わったか、そのリポジトリを追いかけるのをやめた可能性があります。
    </p>
    <a href="/" class="chip" style="height: 40px; padding: 0 18px;">今日のトレンドを見る</a>
  </main>
</Base>
