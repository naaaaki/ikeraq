---
/**
 * 一覧のページ送り
 *
 * 前後と番号だけ。件数が多くても番号は前後2つまでに畳む（スマホで折り返さないように）。
 */
import { pageHref, type PagerInfo } from '../lib/paginate.js';
import { num } from '../lib/format.js';

interface Props {
  pager: PagerInfo;
}
const { pager } = Astro.props;
const { current, total, basePath, offset, allCount, count } = pager;

const shown = new Set([1, total, current - 2, current - 1, current, current + 1, current + 2]);
const numbers = [...shown].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
---

{
  total > 1 && (
    <nav class="pager" aria-label="ページ送り">
      <span class="meta">{num(allCount)}件中 {num(offset + 1)}〜{num(offset + count)}件目</span>
      <span class="pages">
        {current > 1 && <a href={pageHref(basePath, current - 1)} rel="prev">← 前へ</a>}
        {numbers.map((n, i) => (
          <>
            {i > 0 && n - numbers[i - 1] > 1 && <span class="gap">…</span>}
            {n === current ? <span aria-current="page" class="cur">{n}</span> : <a href={pageHref(basePath, n)}>{n}</a>}
          </>
        ))}
        {current < total && <a href={pageHref(basePath, current + 1)} rel="next">次へ →</a>}
      </span>
    </nav>
  )
}

<style>
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    padding: 26px 0 8px;
    border-top: 1px solid var(--rule2);
    margin-top: 8px;
  }
  .pages {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }
  .pages a,
  .pages .cur {
    min-width: 32px;
    padding: 5px 9px;
    text-align: center;
    border: 1px solid var(--rule2);
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
  }
  .pages .cur {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper, #fff);
    font-weight: 700;
  }
  .gap {
    color: var(--ink3);
  }
</style>
