---
/**
 * ピックアップの伸びを、ひとことで言う（トップのピックアップ用）
 *
 * ★ 大きい数字にしない。原本（design/Main.dc.html）のピックアップは、伸びを
 *   メタ行の中の1つとしてしか出していない。38px の数字はページ見出しと同じ大きさで、
 *   日本語の紹介文（16px・このサイトの主役／D-001）から主役の座を奪ってしまう。
 *
 * ★ 枠を付けない。枠を付けるのはライセンスだけ（global.css の決めごと）。
 *   似た形の緑の枠が2つ並ぶと、読者はどちらが大事か決められなくなる。
 *
 * ★「1位」ではなく「今日いちばん伸びています」と書く。記号は読み解く時間がかかるが、
 *   日本語は読んだ瞬間に届く。強さは大きさではなく、置く位置と色で作る。
 *
 * ★ 数字（+1,944）はここに出さない。同じ数字がメタ行にも出て、焦点が2つに割れる。
 *
 * ★ 母数を必ず添える。書かないと「GitHub 全体で1位」と読まれる（誇大表示になる）。
 */
import { num } from '../lib/format.js';

interface Props {
  /** その日の増加の順位。1位から数える。増えていない日は null */
  rank: number | null;
  /**
   * 順位をつけた総数。母数として必ず出す。
   * ★ 追跡件数（1,000）ではない。収集が途中で切れた日はここが縮む。
   *   追跡件数に差し替えると、見ていない日ぶんを母数に含めることになり誇大になる。
   */
  rankTotal: number;
}
const { rank, rankTotal } = Astro.props;

/**
 * ★ 順位の数字を出さない。
 *
 *   ピックアップは紹介文を書いたものだけを並べる枠なので、上位に「まだ書いていない
 *   もの」があると番号が飛ぶ。実際に 1位・3位・4位 と並んで、読む人には
 *   なぜ2位が無いのか分からない状態になっていた。
 *
 *   「いちばん」は1件しかないので飛びようがない。それ以外は数えずに
 *   「よく伸びています」と言う。順位の強さを残したまま、飛び番だけを消せる。
 */
/** ここまでを「よく伸びている」と言う。判定基準は docs/criteria.md に公開してある */
const WELL_GROWING_RANK = 10;

const word =
  rank === 1 ? '今日いちばん伸びています' : rank !== null && rank <= WELL_GROWING_RANK ? '今日よく伸びています' : null;
---

{
  word !== null && (
    <div style="display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; margin-bottom: 9px;">
      <span class="meta">スターの増加を確認できた{num(rankTotal)}件の中で</span>
      <span style="font-size: 14px; font-weight: 500; color: var(--accent); letter-spacing: .02em;">{word}</span>
    </div>
  )
}
