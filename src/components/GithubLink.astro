---
/**
 * GitHub（原典）へのリンク
 *
 * ★ここは必ず目立たせる。紹介サイトなので、
 *  「詳しくは本家へ」の出口が分からないと、読んだ人の行き場がなくなる。
 *
 * 灰色の小さな文字だと、ライセンスやスター数に埋もれて気づかれない。
 * GitHub の印を付けて、枠で囲って、押せるものだと分かる形にする。
 *
 * variant
 *   chip   … 一覧の中。小さいが枠があるので押せると分かる
 *   button … 個別ページ。原典へ行く主要な出口なので大きく出す
 */
interface Props {
  id: string;
  variant?: 'chip' | 'button';
}
const { id, variant = 'chip' } = Astro.props;
const href = `https://github.com/${id}`;
---

<a
  class={`gh gh-${variant}`}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${id} を GitHub で開く（新しいタブ）`}
>
  {/* 印の中身は Base.astro に1回だけ置いてある（一覧で行ごとに書き出すと重いため） */}
  <svg class="gh-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><use href="#gh-mark"></use></svg>

  <span class="gh-label">{variant === 'button' ? 'GitHub で見る' : 'GitHub'}</span>

  {variant === 'button' && <span class="gh-id">{id}</span>}

  <svg class="gh-out" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#gh-out"></use></svg>
</a>
