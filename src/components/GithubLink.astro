---
/**
 * GitHub（原典）へのリンク
 *
 * ★ここは必ず目立たせる。紹介サイトなので、
 *  「詳しくは本家へ」の出口が分からないと、読んだ人の行き場がなくなる。
 *
 * 灰色の小さな文字だと、ライセンスやスター数に埋もれて気づかれない。
 * GitHub の印を付けて、枠で囲って、押せるものだと分かる形にする。
 *
 * variant
 *   chip   … 一覧の中。小さいが枠があるので押せると分かる
 *   button … 個別ページ。原典へ行く主要な出口なので大きく出す
 */
interface Props {
  id: string;
  variant?: 'chip' | 'button';
}
const { id, variant = 'chip' } = Astro.props;
const href = `https://github.com/${id}`;
---

<a
  class={`gh gh-${variant}`}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${id} を GitHub で開く（新しいタブ）`}
>
  <svg class="gh-mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
    ></path>
  </svg>

  <span class="gh-label">{variant === 'button' ? 'GitHub で見る' : 'GitHub'}</span>

  {variant === 'button' && <span class="gh-id">{id}</span>}

  <svg class="gh-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M7 17 17 7"></path>
    <path d="M9 7h8v8"></path>
  </svg>
</a>
