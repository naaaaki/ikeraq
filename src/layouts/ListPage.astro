---
/**
 * 一覧ページの枠（カテゴリ・言語・日次・日本語README・トレンドで共通）
 *
 * 見出しとリード文だけ差し替えれば1ページ増える形にしておく。
 */
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import RepoListSection from '../components/RepoListSection.astro';
import type { RepoView } from '../lib/content.js';
import type { PagerInfo } from '../lib/paginate.js';

interface Props {
  title: string;
  heading: string;
  description: string;
  /** 見出しの下に置く1〜2行。何を集めたページなのかを書く */
  lede?: string;
  items: RepoView[];
  label: string;
  note?: string;
  empty: string;
  noindex?: boolean;
  deltaLabel?: string;
  pager?: PagerInfo;
  noteTotal?: number;
}
const { title, heading, description, lede, items, label, note, empty, noindex = false, deltaLabel, pager, noteTotal } =
  Astro.props;

// ★ 2ページ目以降は題名と説明を変える。同じ題名のページが並ぶと、検索エンジンは重複として扱う
const pageSuffix = pager && pager.current > 1 ? `（${pager.current}ページ目）` : '';
---

<Base title={`${title}${pageSuffix}`} description={pageSuffix ? `${description}${pageSuffix}` : description} noindex={noindex}>
  <main id="main" style="flex: 1; min-width: 0;">
    <div style="padding: 44px 0 28px;">
      <h1 class="display" style="margin: 0; font-size: 34px; line-height: 1.2;">{heading}{pageSuffix && <span class="meta" style="font-size: 15px; margin-left: 10px;">{pageSuffix}</span>}</h1>
      {lede && <p class="meta" style="margin: 12px 0 0; font-size: 13px; line-height: 1.9; max-width: 620px;">{lede}</p>}
    </div>

    <RepoListSection
      items={items}
      label={label}
      note={note}
      empty={empty}
      deltaLabel={deltaLabel}
      pager={pager}
      noteTotal={noteTotal}
    />
  </main>

  <Sidebar />
</Base>
